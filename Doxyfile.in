PROJECT_NAME           = "sentinel"
PROJECT_NUMBER         = "@PROJECT_VERSION@"
PROJECT_BRIEF          = "Cross-platform C++ diagnostics for embedded and native targets"
OUTPUT_DIRECTORY       = "@SENTINEL_DOXYGEN_OUTPUT_DIR@"
HTML_OUTPUT            = html

INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/README.md" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/docs" \
                         "@CMAKE_CURRENT_SOURCE_DIR@/include"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/docs/mainpage.md"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"

RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = YES
MULTILINE_CPP_IS_BRIEF = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
INTERNAL_DOCS          = YES
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO
SKIP_FUNCTION_MACROS   = NO
PREDEFINED             =

GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

WARN_IF_UNDOCUMENTED   = NO
WARN_AS_ERROR          = NO
QUIET                  = NO
