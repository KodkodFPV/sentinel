{
  "version": 6,
  "configurePresets": [
    {
      "name": "_root-config",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SENTINEL_BUILD_TESTS": "ON",
        "SENTINEL_PLATFORM": "none"
      }
    },
    {
      "name": "gcc",
      "displayName": "GCC (Multi-Config)",
      "inherits": "_root-config",
      "generator": "Ninja Multi-Config"
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Multi-Config)",
      "inherits": "_root-config",
      "generator": "Ninja Multi-Config"
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc",
      "configuration": "Debug"
    },
    {
      "name": "gcc-release",
      "configurePreset": "gcc",
      "configuration": "Release"
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug"
    },
    {
      "name": "msvc-release",
      "configurePreset": "msvc",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "gcc-debug",
      "configurePreset": "gcc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": true }
    },
    {
      "name": "msvc-debug",
      "configurePreset": "msvc",
      "configuration": "Debug",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "stopOnFailure": true }
    }
  ],
  "workflowPresets": [
    {
      "name": "gcc",
      "displayName": "GCC (Debug): Config & Build",
      "steps": [
        { "type": "configure", "name": "gcc" },
        { "type": "build", "name": "gcc-debug" }
      ]
    },
    {
      "name": "msvc",
      "displayName": "MSVC (Debug): Config & Build",
      "steps": [
        { "type": "configure", "name": "msvc" },
        { "type": "build", "name": "msvc-debug" }
      ]
    }
  ]
}
